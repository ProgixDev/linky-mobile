{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/linky.apk",
      "destination": "https://njii6olstwjlpvas.public.blob.vercel-storage.com/linky.apk"
    },
    {
      "source": "/linky-driver.apk",
      "destination": "https://njii6olstwjlpvas.public.blob.vercel-storage.com/linky-driver.apk"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/linky.apk",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"linky.apk\"" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" }
      ]
    },
    {
      "source": "/linky-driver.apk",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"linky-driver.apk\"" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" }
      ]
    }
  ]
}
