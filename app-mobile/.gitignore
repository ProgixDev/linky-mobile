node_modules/
.expo/
dist/
.expo-shared/
ios/
android/
# ...sauf les sources du module natif local. La regle « android/ » ci-dessus
# attrape N'IMPORTE QUEL dossier de ce nom, a n'importe quelle profondeur : le
# Kotlin de modules/media-chooser/android/ etait donc ignore en silence. Les
# fichiers deja suivis ne sont pas concernes par un .gitignore, mais un NOUVEAU
# fichier natif l'aurait ete — et ne serait jamais parti au build.
!modules/**/android/
!modules/**/android/**
*.log
.DS_Store
.env*
!.env.example
.mcp.json
expo-env.d.ts
nativewind-env.d.ts

# Daily reports / plans / scratch artifacts that live in the repo root
DAILY_REPORT_*
WORK_PLAN.*
BACKEND_PLAN.*
MAPS_SETUP_ISSUE.*
*.pdf
*.html

# Test QR artifacts (generated by scripts/gen-test-qr.js)
scripts/test-qr-*.png

# Supabase CLI scratch
supabase/.temp/

# PDF regen backups
*.previous.pdf.bak
.git-commit-msg.tmp

# Cles privees Apple (App Store Connect API, APNs). Un `git add -A` suffirait
# a publier la cle de signature ; le depot a deja connu un incident de ce type.
*.p8
AuthKey_*

# Cles de compte de service Google (FCM V1, Play Store). Ce sont des CLES
# PRIVEES : elles autorisent l'envoi de notifications et la publication au nom
# du projet. Elles vivent sur les serveurs EAS, jamais dans le depot — un secret
# commite reste dans l'historique meme apres suppression.
# Attention : `eas build` archive aussi des fichiers ignores par git, donc ne
# pas les deposer dans ce dossier meme ignores.
*firebase-adminsdk*.json
*service-account*.json
google-service-account*.json
